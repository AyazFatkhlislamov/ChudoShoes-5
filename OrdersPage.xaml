<Page x:Class="ChudoShoes.OrdersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Чудо Обувь — Управление заказами"
      FontFamily="Calibri"
      TextElement.FontFamily="Calibri">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" Padding="20,10" BorderBrush="#D2F6E7" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Управление заказами" FontSize="20" VerticalAlignment="Center" Foreground="#2A4B49"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnCreateOrderViaCatalog" Content="Добавить заказ" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,10,0" FontSize="14" Click="BtnCreateOrderViaCatalog_Click"/>
                    <Button Name="BtnDeleteOrder" Content="Удалить заказ" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,10,0" FontSize="14" Click="BtnDeleteOrder_Click"/>
                    <Button Name="BtnBackToCatalog" Content="В каталог товаров" Background="#70B2AF" Foreground="White" Padding="14,6" Margin="0,0,20,0" FontSize="14" Click="BtnBackToCatalog_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="UserName" Text="" FontSize="16" TextAlignment="Right"/>
                        <TextBlock Name="UserRole" Text="" FontSize="13" Foreground="#666666" TextAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="15,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.95*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Список заказов:" FontSize="15" FontWeight="Bold" Foreground="#2A4B49" Margin="0,0,0,8"/>
                    <DataGrid Name="DataGridOrders" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" SelectionChanged="DataGridOrders_SelectionChanged" BorderThickness="1" BorderBrush="#E5E5E5" Background="White" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№ заказа" Binding="{Binding OrderNumber}" Width="75"/>
                            <DataGridTextColumn Header="Дата заказа" Binding="{Binding OrderDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="105"/>
                            <DataGridTextColumn Header="ФИО клиента" Binding="{Binding ClientFullName}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Name="BorderAdminDateEdit" Grid.Row="2" Background="#F8FCFA" BorderBrush="#D2F6E7" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Дата заказа:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13"/>
                            <DatePicker Name="DatePickerOrder" Width="125" Height="26" Margin="0,0,10,0"/>
                            <Button Name="BtnSaveDate" Content="Сохранить дату" Background="#70B2AF" Foreground="White" Padding="10,4" FontSize="13" Click="BtnSaveDate_Click"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="#DCDCDC" BorderThickness="1" CornerRadius="4" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Name="TextBlockOrderTitle" Grid.Row="0" Text="Выберите заказ слева для просмотра его состава" FontSize="15" FontWeight="Bold" Foreground="#2A4B49" Margin="0,0,0,8"/>
                    <DataGrid Name="DataGridOrderItems" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="1" BorderBrush="#E5E5E5" Background="White" RowHeaderWidth="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Товарная позиция (модель и производство)" Binding="{Binding ModelAndManufacturer}" Width="*"/>
                            <DataGridTextColumn Header="Размер" Binding="{Binding SizeValue}" Width="65"/>
                            <DataGridTextColumn Header="Количество" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="Цена за ед." Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ₽'}" Width="95"/>
                            <DataGridTextColumn Header="Сумма" Binding="{Binding ItemTotal, StringFormat='{}{0:N2} ₽'}" Width="95"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Name="BorderAddPositionBox" Grid.Row="2" Background="#F8FCFA" BorderBrush="#D2F6E7" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Редактирование состава заказа — добавить позицию (поиск по наименованию):" FontSize="13" Foreground="#2A4B49" Margin="0,0,0,5"/>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBox Name="TBoxCatalogSearch" Width="150" Height="26" Margin="0,0,8,4" VerticalContentAlignment="Center" TextChanged="TBoxCatalogSearch_TextChanged"/>
                                <ComboBox Name="ComboCatalogProducts" Width="195" Height="26" Margin="0,0,8,4" SelectionChanged="ComboCatalogProducts_SelectionChanged"/>
                                <ComboBox Name="ComboCatalogSizes" Width="85" Height="26" Margin="0,0,8,4"/>
                                <TextBox Name="TBoxAddQty" Width="45" Height="26" Text="1" Margin="0,0,8,4" VerticalContentAlignment="Center" PreviewTextInput="TBoxAddQty_PreviewTextInput"/>
                                <Button Name="BtnAddPositionToOrder" Content="Добавить позицию" Background="#70B2AF" Foreground="White" Padding="10,4" Margin="0,0,6,4" FontSize="13" Click="BtnAddPositionToOrder_Click"/>
                                <Button Name="BtnOpenProductCard" Content="Карточка модели" Background="#70B2AF" Foreground="White" Padding="8,4" Margin="0,0,0,4" FontSize="13" Click="BtnOpenProductCard_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Grid.Row="3" Margin="0,8,0,0">
                        <Button Name="BtnDeleteItem" Content="Удалить выбранную позицию из заказа" Background="#70B2AF" Foreground="White" Padding="12,5" Margin="0,0,0,8" HorizontalAlignment="Left" FontSize="13" Click="BtnDeleteItem_Click" Visibility="Collapsed"/>
                        <Border Background="#D2F6E7" Padding="10" CornerRadius="3">
                            <Grid>
                                <TextBlock Text="Итоговая сумма по заказу:" FontSize="15" VerticalAlignment="Center" Foreground="#2A4B49"/>
                                <TextBlock Name="TextBlockTotalSum" Text="0.00 ₽" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#1B4D3E"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#D2F6E7" Padding="20,8">
            <TextBlock Name="TextBlockRecordsCount" Text="Всего заказов в системе: 0" FontSize="14" Foreground="#2A4B49"/>
        </Border>
    </Grid>
</Page>
