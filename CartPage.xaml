<Page x:Class="ChudoShoes.CartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Чудо Обувь — Оформление и подтверждение заказа"
      FontFamily="Calibri"
      TextElement.FontFamily="Calibri">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FFFFFF" Padding="20,10" BorderBrush="#D2F6E7" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Формирование и подтверждение заказа" FontSize="20" Foreground="#2A4B49" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnBack" Content="Добавить ещё товары из каталога" Background="#70B2AF" Foreground="White" Padding="14,6" Margin="0,0,20,0" FontSize="14" Click="BtnBack_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="UserName" Text="" FontSize="16" TextAlignment="Right"/>
                        <TextBlock Name="UserRole" Text="" FontSize="13" Foreground="#666666" TextAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
        <Border Name="BorderClientSelector" Grid.Row="1" Background="#F8FCFA" Padding="20,8" BorderBrush="#D2F6E7" BorderThickness="0,0,0,1" Visibility="Collapsed">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="Клиент (ФИО заказчика):" FontSize="14" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#2A4B49"/>
                <ComboBox Name="ComboOrderClient" Width="320" Height="28" FontSize="14" SelectionChanged="ComboOrderClient_SelectionChanged"/>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" Margin="20,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid Name="DataGridCart" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" BorderThickness="1" BorderBrush="#DCDCDC" Background="White" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Наименование модели" Binding="{Binding Product.CleanProductName}" Width="*"/>
                    <DataGridTextColumn Header="Производство" Binding="{Binding Product.ManufacturerTitle}" Width="160"/>
                    <DataGridTextColumn Header="Размер" Binding="{Binding SizeValue}" Width="75"/>
                    <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity}" Width="75"/>
                    <DataGridTextColumn Header="Доступно" Binding="{Binding MaxAvailable}" Width="80"/>
                    <DataGridTextColumn Header="Цена за ед." Binding="{Binding UnitPrice, StringFormat='{}{0:N2} ₽'}" Width="110"/>
                    <DataGridTextColumn Header="Сумма" Binding="{Binding TotalPrice, StringFormat='{}{0:N2} ₽'}" Width="115"/>
                </DataGrid.Columns>
            </DataGrid>
            <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button Name="BtnDecreaseQty" Content="Уменьшить кол-во (-1)" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,10,0" FontSize="14" Click="BtnDecreaseQty_Click"/>
                <Button Name="BtnIncreaseQty" Content="Увеличить кол-во (+1)" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,15,0" FontSize="14" Click="BtnIncreaseQty_Click"/>
                <Button Name="BtnRemoveItem" Content="Удалить позицию" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,10,0" FontSize="14" Click="BtnRemoveItem_Click"/>
                <Button Name="BtnCancelOrder" Content="Отказаться от заказа" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,15,0" FontSize="14" Click="BtnCancelOrder_Click"/>
                <Button Name="BtnSubmitOrder" Content="Подтвердить и оформить заказ" Background="#70B2AF" Foreground="White" FontSize="14" FontWeight="Bold" Padding="16,6" Click="BtnSubmitOrder_Click"/>
            </WrapPanel>
        </Grid>
        <Border Grid.Row="3" Background="#D2F6E7" Padding="20,10">
            <Grid>
                <TextBlock Name="TextBlockOrderDateInfo" Text="Дата оформления заказа: сегодня" FontSize="14" Foreground="#2A4B49" VerticalAlignment="Center"/>
                <TextBlock Name="TextBlockCartSum" Text="Итоговая сумма по заказу: 0.00 ₽" FontSize="18" FontWeight="Bold" Foreground="#1B4D3E" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Page>
