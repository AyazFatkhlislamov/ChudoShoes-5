<Page x:Class="ChudoShoes.ProductDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Чудо Обувь — Карточка товара"
      FontFamily="Calibri"
      TextElement.FontFamily="Calibri">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" Padding="20,10" BorderBrush="#D2F6E7" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Карточка товара" FontSize="20" VerticalAlignment="Center" Foreground="#2A4B49"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnGoToCart" Content="Перейти к заказу" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,10,0" FontSize="14" Visibility="Collapsed" Click="BtnGoToCart_Click"/>
                    <Button Name="BtnCancel" Content="Вернуться в каталог" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,20,0" FontSize="14" Click="BtnCancel_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="UserName" Text="" FontSize="16" TextAlignment="Right"/>
                        <TextBlock Name="UserRole" Text="" FontSize="13" Foreground="#666666" TextAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="25,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Name="ProductImage" Grid.Column="0" Width="280" Height="280" Stretch="Uniform" VerticalAlignment="Top"/>

                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Name="TextBlockName" Text="" FontSize="24" FontWeight="Bold" Foreground="#2A4B49" TextWrapping="Wrap"/>
                    <TextBlock Name="TextBlockCategory" Text="" FontSize="15" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Name="TextBlockManufacturer" Text="" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Name="TextBlockComposition" Text="" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Name="TextBlockAllSizesRange" Text="" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Name="TextBlockAvailableSizes" Text="" FontSize="15" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    <TextBlock Name="TextBlockDescription" Text="" FontSize="15" Margin="0,10,0,0" TextWrapping="Wrap"/>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBlock Name="TextBlockOldPrice" Text="" FontSize="16" Foreground="#888888" TextDecorations="Strikethrough" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="Collapsed"/>
                        <TextBlock Name="TextBlockDiscountPrice" Text="" FontSize="24" FontWeight="Bold" Foreground="#1B4D3E" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Name="TextBlockGuestNotice" Text="Для оформления заказа необходимо войти в систему под своим логином." FontSize="14" Foreground="#B00020" Margin="0,15,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>

                    <Border Name="OrderActionPanel" Background="#D2F6E7" Padding="15" Margin="0,15,0,0">
                        <StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock Text="Выберите доступный размер:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Name="ComboSizes" Width="100" Height="28" FontSize="14" Margin="0,0,20,0" SelectionChanged="ComboSizes_SelectionChanged"/>
                                <TextBlock Text="Количество пар:" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Name="TextBoxQuantity" Width="60" Height="28" FontSize="14" Text="1" VerticalContentAlignment="Center" InputMethod.IsInputMethodEnabled="False" PreviewTextInput="TextBoxQuantity_PreviewTextInput"/>
                            </WrapPanel>
                            <TextBlock Name="TextBlockStockAvailable" Text="" FontSize="14" Foreground="#2A4B49" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Name="BtnAddToCart" Content="Добавить в заказ" Background="#70B2AF" Foreground="White" FontSize="14" FontWeight="Bold" Padding="16,6" Margin="0,0,10,0" Click="BtnAddToCart_Click"/>
                                <Button Name="BtnAbortOrder" Content="Отказаться от заказа" Background="#70B2AF" Foreground="White" FontSize="14" Padding="14,6" Click="BtnAbortOrder_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
