<Page x:Class="ChudoShoes.AuthPage"
xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
Title="Авторизация" FontFamily="Calibri">
    <Grid Background="{StaticResource MainBgBrush}">
        <Border Background="{StaticResource SecondaryBgBrush}" 
            CornerRadius="8" Width="360" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
            <StackPanel>
                <TextBlock Text="Авторизация" FontSize="22" HorizontalAlignment="Center" Margin="0,0,0,20"/>

                <TextBlock Text="Введите логин:" FontSize="15" Margin="0,0,0,5"/>
                <TextBox Name="TBoxLogin" FontSize="16" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,20"/>

                <Button Name="BtnLogin" Content="Войти" Height="36" FontSize="15" Click="BtnLogin_Click" Margin="0,0,0,10"/>
                <Button Name="BtnGuest" Content="Войти как гость" Height="36" FontSize="14" Background="#888888" Click="BtnGuest_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>