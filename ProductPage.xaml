<Page x:Class="ChudoShoes.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Чудо Обувь — Каталог товаров"
      FontFamily="Calibri"
      TextElement.FontFamily="Calibri">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" Padding="20,10" BorderBrush="#D2F6E7" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Каталог обуви" FontSize="20" VerticalAlignment="Center" Foreground="#2A4B49"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnOrders" Content="Управление заказами" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,10,0" FontSize="14" Visibility="Collapsed" Click="BtnOrders_Click"/>
                    <Button Name="BtnCart" Content="Текущий заказ (0)" Background="#70B2AF" Foreground="White" Padding="12,6" Margin="0,0,20,0" FontSize="14" Visibility="Collapsed" Click="BtnCart_Click"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Name="UserName" Text="" FontSize="16" TextAlignment="Right"/>
                        <TextBlock Name="UserRole" Text="" FontSize="13" Foreground="#666666" TextAlignment="Right"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Name="TextBlockOrderModeBanner" Grid.Row="1" Background="#D2F6E7" Foreground="#2A4B49" FontSize="14" Padding="20,8" Visibility="Collapsed"/>

        <WrapPanel Name="FiltersWrapPanel" Grid.Row="2" Margin="20,10,20,5">
            <TextBlock Text="Поиск:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <TextBox Name="TBoxSearch" Width="230" Height="28" FontSize="14" VerticalContentAlignment="Center" Margin="0,0,20,0" TextChanged="TBoxSearch_TextChanged"/>
            <TextBlock Text="Категория:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <ComboBox Name="CBoxFilter" Width="180" Height="28" FontSize="14" Margin="0,0,20,0" SelectionChanged="CBoxFilter_SelectionChanged"/>
            <TextBlock Text="Сортировка по цене:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <ComboBox Name="ComboSort" Width="200" Height="28" FontSize="14" SelectedIndex="0" SelectionChanged="ComboSort_SelectionChanged">
                <ComboBoxItem Content="Без сортировки"/>
                <ComboBoxItem Content="По возрастанию"/>
                <ComboBoxItem Content="По убыванию"/>
            </ComboBox>
        </WrapPanel>

        <ListView Name="ProductListView" Grid.Row="3" Margin="20,5,20,10" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ProductListView_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#DCDCDC" BorderThickness="1" Padding="8" Background="{Binding ProductColor}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="180"/>
                            </Grid.ColumnDefinitions>
                            <Image Grid.Column="0" Source="{Binding ProductPhoto}" Width="110" Height="90" Stretch="Uniform"/>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="{Binding CategoryTitle}" FontSize="12" Foreground="#666666"/>
                                <TextBlock Text="{Binding CleanProductName}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ManufacturerTitle, StringFormat='Производство: {0}'}" FontSize="13" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Composition, StringFormat='Состав: {0}'}" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Price, StringFormat='{}{0:N2} ₽'}" Visibility="{Binding OldPriceVisibility}" TextDecorations="Strikethrough" Foreground="#888888" FontSize="13" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DiscountPrice, StringFormat='{}{0:N2} ₽'}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding QuantityText, StringFormat='Количество пар: {0}'}" FontSize="13" Margin="0,8,0,0" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Border Grid.Row="4" Background="#D2F6E7" Padding="20,8">
            <TextBlock Name="TBNumRecords" Text="Показано: 0 из 0" FontSize="14" Foreground="#2A4B49"/>
        </Border>
    </Grid>
</Page>
