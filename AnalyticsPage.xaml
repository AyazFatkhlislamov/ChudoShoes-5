<Page x:Class="ChudoShoes.AnalyticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Чудо Обувь — Аналитика продаж"
      FontFamily="Calibri"
      TextElement.FontFamily="Calibri">
    <Grid Background="#FFFFFF">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" Padding="20,10" BorderBrush="#D2F6E7" BorderThickness="0,0,0,2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Аналитика продаж" FontSize="20" VerticalAlignment="Center" Foreground="#2A4B49"/>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Name="UserName" Text="" FontSize="16" TextAlignment="Right"/>
                    <TextBlock Name="UserRole" Text="" FontSize="13" Foreground="#666666" TextAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="20,15,20,5">
            <TextBlock Text="Период с:" VerticalAlignment="Center" FontSize="14" Margin="0,0,8,0"/>
            <DatePicker Name="StartDatePicker" Width="160" FontSize="14"
                        SelectedDateChanged="DatePicker_SelectedDateChanged"
                        DateValidationError="DatePicker_DateValidationError"/>
            <TextBlock Text="по:" VerticalAlignment="Center" FontSize="14" Margin="20,0,8,0"/>
            <DatePicker Name="EndDatePicker" Width="160" FontSize="14"
                        SelectedDateChanged="DatePicker_SelectedDateChanged"
                        DateValidationError="DatePicker_DateValidationError"/>
        </StackPanel>

        <TextBlock Name="TextBlockError" Grid.Row="2" Margin="20,0,20,5" FontSize="14" Foreground="#C62828" Visibility="Collapsed" TextWrapping="Wrap"/>

        <Grid Grid.Row="3" Margin="20,10,20,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#D2F6E7" Padding="15" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Количество заказов за период" FontSize="14" Foreground="#2A4B49"/>
                    <TextBlock Name="TextBlockOrdersCount" Text="0" FontSize="32" FontWeight="Bold" Foreground="#2A4B49"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="#D2F6E7" Padding="15" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="Общая сумма продаж за период" FontSize="14" Foreground="#2A4B49"/>
                    <TextBlock Name="TextBlockTotalSum" Text="0,00 ₽" FontSize="32" FontWeight="Bold" Foreground="#2A4B49"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="4" Margin="20,10,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="Топ-5 моделей по количеству проданных пар" FontSize="18" FontWeight="Bold" Foreground="#2A4B49" Margin="0,0,0,8"/>
            <Grid Grid.Row="1">
                <ListView Name="ListViewTop" FontSize="14">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="№" Width="50" DisplayMemberBinding="{Binding Rank}"/>
                            <GridViewColumn Header="Наименование модели" Width="480" DisplayMemberBinding="{Binding ProductName}"/>
                            <GridViewColumn Header="Производитель" Width="220" DisplayMemberBinding="{Binding ManufacturerName}"/>
                            <GridViewColumn Header="Количество пар" Width="140" DisplayMemberBinding="{Binding Quantity}"/>
                        </GridView>
                    </ListView.View>
                </ListView>
                <TextBlock Name="TextBlockEmpty" Text="За выбранный период заказов нет" FontSize="16" Foreground="#666666"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
            </Grid>
        </Grid>

        <Border Grid.Row="5" Background="#D2F6E7" Padding="20,10">
            <Button Name="BtnExportPdf" Content="Экспорт в PDF" Width="180" Height="34" HorizontalAlignment="Left"
                    Background="#70B2AF" Foreground="White" FontSize="14" Click="BtnExportPdf_Click"/>
        </Border>
    </Grid>
</Page>
